# ============================================================
# Nouê Class — variáveis de ambiente
# Copie para .env.local e preencha com os valores reais.
# ============================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Supabase → Project Settings → API → service_role (SECRETA, nunca vaze!)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# URL pública do site. Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: imagem do hero da home. Suba um arquivo no bucket público `covers`
# do Supabase Storage e cole aqui a URL pública. Sem isso, o hero usa um
# gradiente verde e o app funciona normalmente.
NEXT_PUBLIC_HERO_IMAGE_URL=
